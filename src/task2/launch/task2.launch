<launch>
    <rosparam command="load" file="$(find task2)/config/coordinates.yaml"/>

    <node pkg="task2" type="coordinates_publisher" name="coordinates_publisher" output="screen"/>
    <node pkg="task2" type="coordinates_subscriber" name="coordinates_subscriber" output="screen"/>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find task2)/config/task2.rviz"/> 
</launch>